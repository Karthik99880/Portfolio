# Resend API key used by the contact form server action (server-only; never expose to the client)
RESEND_API_KEY=

# Sender shown on contact emails; must be a verified Resend sender (defaults to "Portfolio <onboarding@resend.dev>")
CONTACT_FROM_EMAIL=

# Inbox that receives contact form messages (defaults to siteConfig.email)
CONTACT_TO_EMAIL=
